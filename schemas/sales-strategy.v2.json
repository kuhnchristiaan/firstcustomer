{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0"
    },
    "executiveSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1400
    },
    "changesFromPrevious": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1400
      }
    },
    "firstMove": {
      "type": "object",
      "properties": {
        "segment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1400
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1400
        },
        "where": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1400
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1400
        },
        "minutes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1400
        },
        "continueWhen": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1400
        },
        "changeWhen": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1400
        }
      },
      "required": [
        "segment",
        "why",
        "where",
        "action",
        "minutes",
        "message",
        "continueWhen",
        "changeWhen"
      ],
      "additionalProperties": false
    },
    "prioritizedSegments": {
      "minItems": 3,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1400
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1400
          }
        },
        "required": [
          "name",
          "priority",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "positioning": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1400
    },
    "channels": {
      "minItems": 2,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1400
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1400
          },
          "segment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1400
          },
          "weeklyMinutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "monthlyDirectCost": {
            "type": "number",
            "minimum": 0
          },
          "costCurrency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "timeHorizonAssumption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1400
          },
          "risks": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1400
          },
          "evidenceLevel": {
            "type": "string",
            "const": "Inferred — unvalidated experiment"
          },
          "firstAction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1400
          }
        },
        "required": [
          "name",
          "priority",
          "rationale",
          "segment",
          "weeklyMinutes",
          "monthlyDirectCost",
          "costCurrency",
          "timeHorizonAssumption",
          "risks",
          "evidenceLevel",
          "firstAction"
        ],
        "additionalProperties": false
      }
    },
    "whyTopChannel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1400
    },
    "firstTen": {
      "type": "object",
      "properties": {
        "segment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1400
        },
        "experiment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1400
        },
        "batchPlanningTarget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "targetDisclaimer": {
          "type": "string",
          "const": "Experimental planning target, not a forecast"
        },
        "stages": {
          "minItems": 5,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Prospects identified",
              "Prospects contacted",
              "Qualified conversations",
              "Trial / demo if relevant",
              "Paying customers"
            ]
          }
        },
        "qualificationQuestions": {
          "minItems": 2,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1400
          }
        },
        "objections": {
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1400
          }
        },
        "followUp": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1400
        },
        "changeCriteria": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1400
        },
        "paymentDefinition": {
          "type": "string",
          "const": "A free signup or trial is not a paying customer; count only confirmed payment."
        }
      },
      "required": [
        "segment",
        "experiment",
        "batchPlanningTarget",
        "targetDisclaimer",
        "stages",
        "qualificationQuestions",
        "objections",
        "followUp",
        "changeCriteria",
        "paymentDefinition"
      ],
      "additionalProperties": false
    },
    "weeks": {
      "minItems": 4,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "week": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1400
          },
          "actions": {
            "minItems": 2,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1400
                },
                "minutes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10080
                }
              },
              "required": [
                "action",
                "minutes"
              ],
              "additionalProperties": false
            }
          },
          "deliverable": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1400
          },
          "successMetric": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1400
          },
          "nextDecision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1400
          }
        },
        "required": [
          "week",
          "objective",
          "actions",
          "deliverable",
          "successMetric",
          "nextDecision"
        ],
        "additionalProperties": false
      }
    },
    "messages": {
      "minItems": 2,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1400
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1400
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1400
          }
        },
        "required": [
          "channel",
          "subject",
          "body"
        ],
        "additionalProperties": false
      }
    },
    "assumptions": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1400
      }
    },
    "validationQuestions": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1400
      }
    }
  },
  "required": [
    "schemaVersion",
    "executiveSummary",
    "changesFromPrevious",
    "firstMove",
    "prioritizedSegments",
    "positioning",
    "channels",
    "whyTopChannel",
    "firstTen",
    "weeks",
    "messages",
    "assumptions",
    "validationQuestions"
  ],
  "additionalProperties": false
}
