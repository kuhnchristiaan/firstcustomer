          "text": "{\"version\":\"1.0\",\"identity\":{\"name\":\"Senja\",\"summary\":\"Senja collects, organizes and shares testimonials, with customizable collection forms and a centralized library of customer proof.\",\"category\":\"Customer acquisition\",\"primaryJob\":{\"actor\":\"Businesses and marketing teams\",\"problem\":\"Collecting customer testimonials and finding relevant proof to share across marketing channels\",\"outcome\":\"Centralize testimonials and reuse them to support customer trust and marketing\"},\"certainty\":\"Website-supported\",\"evidence\":[{\"blockId\":\"cae551e2b6e4\" \t} \t] } \t,\"statements\":[{\"id\":\"s1\",\"text\":\"Senja offers customizable testimonial collection forms with personalized introductory videos and automated video and text collection.\",\"kind\":\"Owner product claim\",\"subject\":\"Owner product\",\"evidence\":[{\"blockId\":\"8088337baf9d\" \t} \t] } \t,{\"id\":\"s2\",\"text\":\"Senja supports importing testimonials from more than 30 platforms or CSV and automation through Zapier, an API and webhooks.\",\"kind\":\"Owner product claim\",\"subject\":\"Owner product\",\"evidence\":[{\"blockId\":\"d31a29723b2c\" \t} \t] } \t,{\"id\":\"s3\",\"text\":\"Senja provides a shared place for testimonial proof, with natural-language search and filtering by offer, buyer, industry, product and plan.\",\"kind\":\"Owner product claim\",\"subject\":\"Owner product\",\"evidence\":[{\"blockId\":\"1224993c1e20\" \t} \t] } \t,{\"id\":\"s4\",\"text\":\"The website advertises free signup and adding collected testimonials to a website.\",\"kind\":\"Website observation\",\"subject\":\"Owner product\",\"evidence\":[{\"blockId\":\"21e09887a3aa\" \t} \t] } \t],\"limitations\":[\"Capabilities are owner claims, not independently verified.\",\"The supplied content does not establish free-plan limits or paid pricing.\"]}"
        }
