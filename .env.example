# Create a completely separate FirstCustomers Neon project. Never reuse EDUCERT.
DATABASE_URL=postgresql://USER:PASSWORD@FIRSTCUSTOMERS-POOLER/neondb?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@FIRSTCUSTOMERS-DIRECT/neondb?sslmode=require
# Neon CLI provides this direct connection; Prisma prefers it when present.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@FIRSTCUSTOMERS-DIRECT/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR-FIRSTCUSTOMERS-AUTH-ENDPOINT/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters
APP_URL=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Development only. Never enable this in production.
MOCK_ANALYSIS=true
MAX_PAGES=5
MAX_CONTENT_CHARS=24000
MAX_INPUT_TOKENS=20000
MAX_OUTPUT_TOKENS=4500
MONTHLY_ANALYSIS_QUOTA=20
MAX_CONCURRENT_ANALYSES=1
# Optional current model rates; omit to record cost as unavailable, never invented.
# OPENAI_INPUT_USD_PER_MILLION=
# OPENAI_OUTPUT_USD_PER_MILLION=

# Guest reports are disabled until protection and cost settings are explicitly configured.
GUEST_ANALYSIS_ENABLED=false
GUEST_TTL_HOURS=24
GUEST_IP_MODE=vercel
GUEST_IP_HASH_SECRET=replace-with-a-random-secret-at-least-32-characters
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GUEST_DAILY_CAP=20
GUEST_IP_DAILY_ATTEMPTS=3
GUEST_IP_HOURLY_ATTEMPTS=2
GUEST_MAX_ATTEMPTS=2
GUEST_MAX_CONCURRENT=2
GUEST_MAX_PAGES=3
GUEST_MAX_INPUT_TOKENS=30000
GUEST_MAX_OUTPUT_TOKENS=6000
GUEST_PRICED_MODEL=gpt-4.1-mini
# Set these to the current published rates for exactly GUEST_PRICED_MODEL.
GUEST_INPUT_USD_PER_MILLION=0.40
GUEST_OUTPUT_USD_PER_MILLION=1.60
GUEST_MAX_COST_USD=0.03
# Optional scheduled cleanup; use a random 32+ character secret.
# CRON_SECRET=

# Enable only after applying the additive strategy revision migration.
STRATEGY_REFINEMENT_ENABLED=false

# Optional exact Wi-Fi origin for npm run dev:lan. Ignored in production.
DEV_LAN_ORIGIN=
