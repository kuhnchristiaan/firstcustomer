generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String         @id
  email              String
  name               String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  memberships        Membership[]
  ownedOrganizations Organization[]
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  ownerId     String       @unique
  owner       User         @relation(fields: [ownerId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  products    Product[]
  events      AuditEvent[]
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("OWNER")
  status         String       @default("ACTIVE")
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
}

model Product {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  name           String
  websiteUrl     String
  description    String            @default("")
  status         String            @default("DRAFT")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  sources        WebsiteSource[]
  analyses       AnalysisRun[]
  profiles       ProductProfile[]
  advisor        AdvisorWorkspace?

  @@unique([organizationId, websiteUrl])
  @@index([organizationId])
}

model WebsiteSource {
  id          String      @id @default(cuid())
  productId   String?
  product     Product?    @relation(fields: [productId], references: [id], onDelete: Restrict)
  analysisId  String
  analysis    AnalysisRun @relation(fields: [analysisId], references: [id])
  url         String
  title       String
  content     String
  contentHash String
  fetchedAt   DateTime    @default(now())
  status      String
}

model AnalysisRun {
  id                String                @id @default(cuid())
  productId         String?
  product           Product?              @relation(fields: [productId], references: [id], onDelete: Restrict)
  guestSessionId    String?
  guestSession      GuestAnalysisSession? @relation(fields: [guestSessionId], references: [id])
  status            String                @default("RUNNING")
  startedAt         DateTime              @default(now())
  completedAt       DateTime?
  leaseExpiresAt    DateTime
  provider          String
  model             String
  inputTokens       Int                   @default(0)
  outputTokens      Int                   @default(0)
  estimatedCost     Decimal?              @db.Decimal(12, 6)
  error             String?
  output            Json?
  sources           WebsiteSource[]
  profiles          ProductProfile[]
  strategyRevisions StrategyRevision[]

  @@index([productId, startedAt])
  @@index([guestSessionId, startedAt])
}

model GuestAnalysisSession {
  id                    String        @id @default(cuid())
  tokenHash             String        @unique
  websiteUrl            String        @default("")
  createdAt             DateTime      @default(now())
  expiresAt             DateTime
  claimedAt             DateTime?
  claimedOrganizationId String?
  claimedByUserId       String?
  claimedProductId      String?
  analyses              AnalysisRun[]

  @@index([expiresAt, claimedAt])
}

model StrategyRevision {
  id             String             @id @default(cuid())
  analysisId     String
  analysis       AnalysisRun        @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  version        Int
  founderContext Json
  contextHash    String
  output         Json?
  status         String             @default("RUNNING")
  createdAt      DateTime           @default(now())
  leaseExpiresAt DateTime
  provider       String
  model          String
  inputTokens    Int                @default(0)
  outputTokens   Int                @default(0)
  estimatedCost  Decimal?           @db.Decimal(12, 6)
  error          String?
  approvals      StrategyApproval[]

  @@unique([analysisId, version])
  @@index([analysisId, createdAt])
  @@index([status, leaseExpiresAt])
}

model StrategyApproval {
  id         String           @id @default(cuid())
  revisionId String
  revision   StrategyRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  productId  String
  actorId    String
  createdAt  DateTime         @default(now())

  @@index([productId, createdAt])
}

model UsageBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model FunnelMetric {
  day   DateTime @db.Date
  event String
  count Int      @default(0)

  @@id([day, event])
}

model ProductProfile {
  id                  String            @id @default(cuid())
  productId           String
  product             Product           @relation(fields: [productId], references: [id])
  analysisId          String
  analysis            AnalysisRun       @relation(fields: [analysisId], references: [id])
  version             Int
  businessDescription String
  mainOffering        String
  industry            String
  valueProposition    String
  geographicFocus     String
  reviewStatus        String            @default("APPROVED")
  approvedBy          String
  approvedAt          DateTime          @default(now())
  findings            Json
  segments            CustomerSegment[]

  @@unique([productId, version])
}

model CustomerSegment {
  id            String         @id @default(cuid())
  profileId     String
  profile       ProductProfile @relation(fields: [profileId], references: [id])
  name          String
  industry      String
  customerType  String
  buyerRoles    String[]
  problems      String[]
  motivations   String[]
  buyingSignals String[]
  priority      Int
  evidence      Json
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorId        String
  action         String
  resourceId     String
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model AdvisorWorkspace {
  id             String                @id @default(cuid())
  productId      String                @unique
  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  founderContext Json
  profile        Json?
  sources        Json?
  version        Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  strategies     AdvisorStrategy[]
  operations     AdvisorOperation[]
  weeklyReviews  AdvisorWeeklyReview[]
}

model AdvisorStrategy {
  id              String               @id @default(cuid())
  workspaceId     String
  workspace       AdvisorWorkspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  version         Int
  strategyVersion Int                  @default(1)
  founderContext  Json
  output          Json
  fixture         Boolean              @default(false)
  createdAt       DateTime             @default(now())
  tasks           AdvisorTask[]
  weeklyReview    AdvisorWeeklyReview?

  @@unique([workspaceId, version])
}

model AdvisorTask {
  id          String          @id @default(cuid())
  strategyId  String
  strategy    AdvisorStrategy @relation(fields: [strategyId], references: [id], onDelete: Restrict)
  position    Int
  completed   Boolean         @default(false)
  completedAt DateTime?
  version     Int             @default(0)

  @@unique([strategyId, position])
}

model AdvisorWeeklyReview {
  id            String           @id @default(cuid())
  workspaceId   String
  workspace     AdvisorWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  planId        String           @unique
  plan          AdvisorStrategy  @relation(fields: [planId], references: [id], onDelete: Restrict)
  submissionKey String
  results       Json
  resultsHash   String
  status        String           @default("SUBMITTED")
  proposal      Json?
  fixture       Boolean          @default(false)
  createdAt     DateTime         @default(now())
  reviewedAt    DateTime?
  acceptedAt    DateTime?
  acceptedBy    String?
  nextPlanId    String?          @unique

  @@unique([workspaceId, submissionKey])
  @@index([workspaceId, createdAt])
}

model AdvisorOperation {
  id             String           @id @default(cuid())
  workspaceId    String
  workspace      AdvisorWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  kind           String
  requestKey     String
  status         String           @default("RUNNING")
  leaseExpiresAt DateTime
  createdAt      DateTime         @default(now())
  completedAt    DateTime?
  model          String
  reservedUsd    Decimal          @db.Decimal(12, 6)
  usage          Json?
  estimatedCost  Decimal?         @db.Decimal(12, 6)
  output         Json?
  error          String?

  @@unique([workspaceId, kind, requestKey])
  @@index([status, leaseExpiresAt])
}
